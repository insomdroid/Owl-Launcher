<androidx.preference.PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:launcher="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory android:title="@string/owl_group_icons">
        <com.android.launcher3.owl.OwlIconPackRow
            android:key="pref_owl_icon_pack"
            android:title="@string/owl_icon_pack_title"
            android:fragment="com.android.launcher3.owl.OwlIconPackFragment" />
        <com.android.launcher3.owl.OwlUnthemedRow
            android:key="owl_unthemed_mode"
            android:title="Apps outside the pack"
            android:fragment="com.android.launcher3.owl.OwlUnthemedFragment" />
        <com.android.launcher3.owl.OwlChoiceRow
            android:key="owl_icon_shape"
            android:title="Icon shape"
            android:fragment="com.android.launcher3.owl.OwlChoiceFragment">
            <extra android:name="owl_pref" android:value="owl_icon_shape" />
        </com.android.launcher3.owl.OwlChoiceRow>
        <com.android.launcher3.owl.OwlChoiceRow
            android:key="owl_backplate_mode"
            android:title="Backplate for apps outside the pack"
            android:fragment="com.android.launcher3.owl.OwlChoiceFragment">
            <extra android:name="owl_pref" android:value="owl_backplate_mode" />
        </com.android.launcher3.owl.OwlChoiceRow>
        <com.android.launcher3.owl.OwlChoiceRow
            android:key="owl_backplate_color"
            android:title="Backplate colour"
            android:fragment="com.android.launcher3.owl.OwlChoiceFragment">
            <extra android:name="owl_pref" android:value="owl_backplate_color" />
        </com.android.launcher3.owl.OwlChoiceRow>
        <SeekBarPreference
            android:key="owl_backplate_opacity"
            android:title="Backplate opacity"
            android:defaultValue="100"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            android:persistent="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/owl_group_wallpaper">
        <SwitchPreferenceCompat
            android:key="owl_wallpaper_scrolling"
            android:title="Wallpaper scrolling"
            android:summary="Move the wallpaper with the home pages"
            android:defaultValue="true"
            android:persistent="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/owl_group_dock">
        <SwitchPreferenceCompat
            android:key="owl_dock_enabled"
            android:title="Show dock"
            android:summary="Show the dock at the bottom of the home screen"
            android:defaultValue="true"
            android:persistent="true" />
        <SeekBarPreference
            android:key="owl_dock_bg_opacity"
            android:title="Dock background opacity"
            android:defaultValue="0"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <SeekBarPreference
            android:key="owl_scale_dock"
            android:title="Dock icon size"
            android:defaultValue="100"
            android:max="150"
            app:min="50"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <SeekBarPreference
            android:key="owl_label_scale_dock"
            android:title="Dock label size"
            android:defaultValue="100"
            android:max="150"
            app:min="50"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <SwitchPreferenceCompat
            android:key="owl_dock_labels"
            android:title="Dock labels"
            android:summary="Show app names under dock icons"
            android:defaultValue="false"
            android:persistent="true" />
        <com.android.launcher3.owl.OwlChoiceRow
            android:key="owl_label_color_dock"
            android:title="Dock label colour"
            android:fragment="com.android.launcher3.owl.OwlChoiceFragment">
            <extra android:name="owl_pref" android:value="owl_label_color_dock" />
        </com.android.launcher3.owl.OwlChoiceRow>
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/owl_group_home_screen">
        <SeekBarPreference
            android:key="owl_scale_home"
            android:title="Home icon size"
            android:defaultValue="100"
            android:max="150"
            app:min="50"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <SeekBarPreference
            android:key="owl_label_scale_home"
            android:title="Home label size"
            android:defaultValue="100"
            android:max="150"
            app:min="50"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <com.android.launcher3.owl.OwlChoiceRow
            android:key="owl_label_color_home"
            android:title="Home label colour"
            android:fragment="com.android.launcher3.owl.OwlChoiceFragment">
            <extra android:name="owl_pref" android:value="owl_label_color_home" />
        </com.android.launcher3.owl.OwlChoiceRow>
        <com.android.launcher3.owl.OwlChoiceRow
            android:key="owl_grid"
            android:title="Grid size"
            android:summary="Columns and rows of the home screen"
            android:fragment="com.android.launcher3.owl.OwlChoiceFragment">
            <extra android:name="owl_pref" android:value="owl_grid" />
        </com.android.launcher3.owl.OwlChoiceRow>
        <com.android.launcher3.owl.OwlChoiceRow
            android:key="owl_home_page"
            android:title="Home page"
            android:summary="The page the HOME button returns to"
            android:fragment="com.android.launcher3.owl.OwlChoiceFragment">
            <extra android:name="owl_pref" android:value="owl_home_page" />
        </com.android.launcher3.owl.OwlChoiceRow>
        <SwitchPreferenceCompat
            android:key="owl_show_page_indicator"
            android:title="Page indicator"
            android:summary="Show the page dots above the dock"
            android:defaultValue="true"
            android:persistent="true" />
        <SwitchPreferenceCompat
            android:key="owl_home_two_line"
            android:title="Two-line home labels"
            android:summary="Let app names wrap onto a second line"
            android:defaultValue="false"
            android:persistent="true" />
        <SwitchPreferenceCompat
            android:key="owl_hide_status_bar"
            android:title="Hide status bar"
            android:summary="Hide the status bar on the home screen"
            android:defaultValue="false"
            android:persistent="true" />
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_workspace_lock"
            android:persistent="true"
            android:title="@string/settings_lock_layout_title"
            android:summaryOn="@string/settings_lock_layout_summary_on"
            android:summaryOff="@string/settings_lock_layout_summary_off" />
        <SwitchPreferenceCompat
            android:key="pref_add_icon_to_home"
            android:title="@string/auto_add_shortcuts_label"
            android:summary="@string/auto_add_shortcuts_description"
            android:defaultValue="true"
            android:persistent="true"
            launcher:logIdOn="613"
            launcher:logIdOff="614" />
        <SwitchPreferenceCompat
            android:key="pref_desktop_show_labels"
            android:title="@string/desktop_show_labels"
            android:defaultValue="true"
            android:persistent="true" />
        <com.android.launcher3.settings.NotificationDotsPreference
            android:key="pref_icon_badging"
            android:title="@string/notification_dots_title"
            android:persistent="false"
            android:widgetLayout="@layout/notification_pref_warning" />
        <SwitchPreferenceCompat
            android:key="pref_allowRotation"
            android:title="@string/allow_rotation_title"
            android:summary="@string/allow_rotation_desc"
            android:defaultValue="@bool/config_allowRotation"
            android:persistent="true"
            launcher:logIdOn="615"
            launcher:logIdOff="616" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/owl_group_app_drawer">
        <SeekBarPreference
            android:key="owl_drawer_bg_opacity"
            android:title="Drawer background opacity"
            android:defaultValue="100"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <SeekBarPreference
            android:key="owl_scale_drawer"
            android:title="Drawer icon size"
            android:defaultValue="100"
            android:max="150"
            app:min="50"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <SeekBarPreference
            android:key="owl_label_scale_drawer"
            android:title="Drawer label size"
            android:defaultValue="100"
            android:max="150"
            app:min="50"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <com.android.launcher3.owl.OwlChoiceRow
            android:key="owl_label_color_drawer"
            android:title="Drawer label colour"
            android:fragment="com.android.launcher3.owl.OwlChoiceFragment">
            <extra android:name="owl_pref" android:value="owl_label_color_drawer" />
        </com.android.launcher3.owl.OwlChoiceRow>
        <SwitchPreferenceCompat
            android:key="owl_drawer_show_search"
            android:title="Show search bar"
            android:summary="Show the search field at the top of the app drawer"
            android:defaultValue="true"
            android:persistent="true" />
        <SwitchPreferenceCompat
            android:key="owl_drawer_blur"
            android:title="Blur wallpaper behind drawer"
            android:summary="Blur the wallpaper while the app drawer is open (Android 12+)"
            android:defaultValue="false"
            android:persistent="true" />
        <SeekBarPreference
            android:key="owl_drawer_blur_strength"
            android:title="Blur strength"
            android:defaultValue="100"
            android:max="200"
            app:min="10"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <Preference
            android:key="owl_drawer_picture"
            android:title="Drawer picture"
            android:summary="Choose an image behind the app drawer" />
        <Preference
            android:key="owl_drawer_picture_clear"
            android:title="Remove drawer picture" />
        <SeekBarPreference
            android:key="owl_drawer_picture_dim"
            android:title="Picture dim"
            android:defaultValue="0"
            android:max="100"
            app:min="0"
            app:showSeekBarValue="true"
            android:persistent="true" />
        <SwitchPreferenceCompat
            android:key="pref_drawer_show_labels"
            android:title="@string/drawer_show_labels"
            android:defaultValue="true"
            android:persistent="true" />
        <SwitchPreferenceCompat
            android:key="pref_drawer_open_keyboard"
            android:title="@string/drawer_open_keyboard_title"
            android:summary="@string/drawer_open_keyboard_summary"
            android:defaultValue="false"
            android:persistent="true" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Weather">
        <Preference
            android:key="owl_weather_location"
            android:title="Allow location"
            android:summary="Used by the weather widget. Weather data from Open-Meteo." />
    </PreferenceCategory>

    <PreferenceCategory android:title="Backup">
        <Preference
            android:key="owl_backup_export"
            android:title="Export settings"
            android:summary="Save all launcher settings to a file" />
        <Preference
            android:key="owl_backup_import"
            android:title="Restore settings"
            android:summary="Load settings from a backup file" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/owl_group_gestures_and_more">
        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="pref_sleep_gesture"
            android:persistent="true"
            android:title="@string/pref_sleep_gesture_title"
            android:summary="@string/pref_sleep_gesture_summary" />
        <Preference
            android:key="pref_trust_apps"
            android:title="@string/trust_apps_manager_name" />
    </PreferenceCategory>
</androidx.preference.PreferenceScreen>
