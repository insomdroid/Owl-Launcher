<?xml version="1.0" encoding="utf-8"?>
<!-- Owl switch track: ON = display fill, OFF = control outline colour (Nothing inversion). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/owl_display" />
            <corners android:radius="999dp" />
            <size android:width="42dp" android:height="24dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/owl_line_2" />
            <corners android:radius="999dp" />
            <size android:width="42dp" android:height="24dp" />
        </shape>
    </item>
</selector>
